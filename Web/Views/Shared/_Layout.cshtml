<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewBag.Title - Courier Service</title>
    <link rel="icon" type="image/x-icon" href="@Url.Content("~/Content/images/favicon.ico")" />
    <link rel="stylesheet" href="~/Content/site.css" />
    <style>
        /* Prevent header clipping and remove internal scrollbars */
        .app-header,
        .app-nav {
            overflow: visible !important;
        }

        /* Container for the nav items */
        .app-nav {
            display: flex !important;
            align-items: center !important;
            gap: 12px !important;
        }

        /* Keep the Scan dropdown tab inline with other links */
        .app-nav__dropdown {
            position: relative !important;
            display: inline-block !important;
            vertical-align: middle !important;
        }

        /* Floating Popup Menu: completely isolated from header layout */
        .app-nav__dropdown-menu {
            display: none !important;
            position: absolute !important;
            top: 100% !important;
            left: 0 !important;
            background-color: #ffffff !important;
            min-width: 180px !important;
            box-shadow: 0px 8px 16px rgba(0, 0, 0, 0.25) !important;
            border-radius: 4px !important;
            border: 1px solid #cccccc !important;
            z-index: 999999 !important;
            padding: 6px 0 !important;
            margin-top: 8px !important;
        }

            /* Option Item Styling */
            .app-nav__dropdown-menu a {
                color: #111111 !important;
                background-color: #ffffff !important;
                padding: 10px 16px !important;
                display: block !important;
                text-decoration: none !important;
                white-space: nowrap !important;
                font-size: 14px !important;
                line-height: 1.2 !important;
                margin: 0 !important;
                height: auto !important;
            }

                /* Hover effect for dropdown item */
                .app-nav__dropdown-menu a:hover {
                    background-color: #f0f0f0 !important;
                    color: #000000 !important;
                }

        /* Hover trigger */
        .app-nav__dropdown:hover .app-nav__dropdown-menu {
            display: block !important;
        }

        .app-nav__arrow {
            display: inline-block !important;
            margin-left: 4px !important;
            font-size: 10px !important;
        }
    </style>
</head>
<body>  
    <header class="app-header">
        <a class="app-header__brand" href="@Url.Action("Index", "Home")">F20 Courier Service</a>
        <nav class="app-nav" aria-label="Main">
            @{
                var currentController = (string)ViewContext.RouteData.Values["controller"];
                var currentAction = (string)ViewContext.RouteData.Values["action"];
                var isScanActive = currentController == "Scan" || currentController == "Collection";
                var userName = Session["UserName"] as string;
                var isSignedIn = !string.IsNullOrWhiteSpace(userName);

            }
            <a class="app-nav__link @(currentController == "Home" ? "is-active" : "")" href="@Url.Action("Index", "Home")">Dashboard</a>
            <!-- The links below are placeholders until their controllers land in later tasks. -->
            <!-- TODO - Role based and login/logout nav bar-->
            <a class="app-nav__link @(currentController == "Packages" && ViewContext.RouteData.Values["action"].ToString() == "Register" ? "is-active" : "")" href="@Url.Action("Register", "Packages")">Register</a>
            <a class="app-nav__link @(currentController == "Packages" && ViewContext.RouteData.Values["action"].ToString() == "Search" ? "is-active" : "")" href="@Url.Action("Search", "Packages")">Search</a>
            <!-- Scan Dropdown using native site.css classes -->
            <div class="app-nav__dropdown">
                <a class="app-nav__link @(isScanActive ? "is-active" : "")" href="@Url.Action("Index", "Scan")">
                    Scan <span class="app-nav__arrow">&#9662;</span>
                </a>
                <div class="app-nav__dropdown-menu">
                    <a class="app-nav__dropdown-item" href="@Url.Action("Index", "Collection")">Package Collection</a>
                </div>
            </div>
            <a class="app-nav__link @(currentController == "CsvImport" ? "is-active" : "")" href="@Url.Action("Index", "CsvImport")">Import</a>
            <a class="app-nav__link @(currentController == "Scan" ? "is-active" : "")" href="@Url.Action("Index", "Scan")">Scan</a>
            <a class="app-nav__link @(currentController == "Account" ? "is-active" : "")" href="@Url.Action("Login", "Account")">Login</a>
            <a class="app-nav__link" href="#">Import</a>
            <a class="app-nav__link" href="#">Audit Log</a>
            <a class="app-nav__link" href="#">Users</a>
            <a class="app-nav__link" href="#">Config</a>
        </nav>
        <span class="app-header__user">Signed in as: &#8208; (auth lands in a later task)</span>
    </header>

    <main class="app-main">
        @RenderBody()
    </main>

    <script src="~/Scripts/app/courier-app.js"></script>
    @RenderSection("scripts", required: false)
</body>
</html>
