@using CourierService.Web.Infrastructure
@{
    var currentController = (string)ViewContext.RouteData.Values["controller"];
    var currentAction = (string)ViewContext.RouteData.Values["action"];

    var isSignedIn = UserSession.IsSignedIn(Session);
    var userName = UserSession.Username(Session);
    var role = UserSession.RoleName(Session);
    var roleName = UserSession.RoleDisplayName(role);
    var isSystemAdmin = role == "SystemAdmin";

    var canRegister = role == "IntakeClerk" || role == "Supervisor" || role == "SystemAdmin";
    var canScan = role == "StorageStaff" || role == "Supervisor" || role == "SystemAdmin";    var canCollect = role == "CollectionStaff" || role == "Supervisor" || role == "SystemAdmin";
    var canImport = role == "Supervisor" || role == "SystemAdmin";
    var canSeeAudit = role == "Supervisor" || role == "SystemAdmin";
    var canSeeReports = role == "Supervisor" || role == "SystemAdmin";
    var canSeeAdmin = canImport || canSeeAudit || canSeeReports || isSystemAdmin;

    var homeActive = currentController == "Home" ? "is-active" : "";
    var packagesActive = (currentController == "Packages" || currentController == "Scan" || currentController == "Collection") ? "is-active" : "";
    var adminActive = (currentController == "CsvImport" || currentController == "Reports" || currentController == "UserManagement") ? "is-active" : "";

    var registerActive = (currentController == "Packages" && currentAction == "Register") ? "is-active" : "";
    var searchActive = (currentController == "Packages" && currentAction == "Search") ? "is-active" : "";
    var scanActive = currentController == "Scan" ? "is-active" : "";
    var collectionActive = currentController == "Collection" ? "is-active" : "";
    var reportsActive = currentController == "Reports" ? "is-active" : "";
    var importActive = currentController == "CsvImport" ? "is-active" : "";
    var usersActive = currentController == "UserManagement" ? "is-active" : "";

    var homeUrl = Url.Action("Index", "Home");
    var registerUrl = Url.Action("Register", "Packages");
    var searchUrl = Url.Action("Search", "Packages");
    var scanUrl = Url.Action("Index", "Scan");
    var collectionUrl = Url.Action("Index", "Collection");
    var reportsUrl = Url.Action("Index", "Reports");
    var importUrl = Url.Action("Index", "CsvImport");
    var usersUrl = Url.Action("Index", "UserManagement");
    var logoUrl = Url.Content("~/Content/images/icon_inverted.png");
    var faviconUrl = Url.Content("~/Content/images/favicon.ico");
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewBag.Title - Courier Service</title>
    <link rel="icon" type="image/x-icon" href="@faviconUrl" />
    <link href="~/Content/bootstrap-icons.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="~/Content/site.css" />
</head>
<body>
    <body class="@(ViewBag.HideFooter == true ? "" : "has-footer")">
    <header class="app-header">
        <a class="app-header__brand" href="@homeUrl">
            <img class="app-header__logo" src="@logoUrl" alt="" />
            <span>F20 Courier Service</span>
        </a>

        @if (isSignedIn)
        {
            <button type="button" class="app-nav-toggle" id="nav-toggle" aria-controls="main-nav" aria-expanded="false" aria-label="Toggle navigation">
                <i class="bi bi-list" aria-hidden="true"></i>
            </button>
        }

        <nav class="app-nav" id="main-nav" aria-label="Main">
            @if (isSignedIn)
            {
                <a class="app-nav__link @homeActive" href="@homeUrl"> Dashboard</a>

                <div class="app-nav__dropdown">
                    <button type="button" class="app-nav__link app-nav__trigger @packagesActive" aria-haspopup="true">
                        Packages <span class="app-nav__arrow">&#9662;</span>
                    </button>
                    <div class="app-nav__dropdown-menu">
                        @if (canRegister)
                        {
                            <a class="app-nav__dropdown-item @registerActive" href="@registerUrl"><i class="bi bi-plus-circle" aria-hidden="true"></i> Register package</a>
                        }
                        <a class="app-nav__dropdown-item @searchActive" href="@searchUrl"><i class="bi bi-search" aria-hidden="true"></i> Search packages</a>
                        @if (canScan)
                        {
                            <a class="app-nav__dropdown-item @scanActive" href="@scanUrl"><i class="bi bi-upc-scan" aria-hidden="true"></i> Scan</a>
                        }
                        @if (canCollect)
                        {
                            <a class="app-nav__dropdown-item @collectionActive" href="@collectionUrl"><i class="bi bi-box-seam" aria-hidden="true"></i> Package collection</a>
                        }
                    </div>
                </div>

                if (canSeeAdmin)
                {
                    <div class="app-nav__dropdown">
                        <button type="button" class="app-nav__link app-nav__trigger @adminActive" aria-haspopup="true">
                            Admin <span class="app-nav__arrow">&#9662;</span>
                        </button>
                        <div class="app-nav__dropdown-menu">
                            @if (canSeeReports)
                            {
                                <a class="app-nav__dropdown-item @reportsActive" href="@reportsUrl"><i class="bi bi-bar-chart" aria-hidden="true"></i> Reports</a>
                            }
                            @if (canImport)
                            {
                                <a class="app-nav__dropdown-item @importActive" href="@importUrl"><i class="bi bi-file-earmark-arrow-down" aria-hidden="true"></i> Import</a>
                            }
                            @if (canSeeAudit)
                            {
                                <a class="app-nav__dropdown-item" href="#"><i class="bi bi-journal-text" aria-hidden="true"></i> Audit log</a>
                            }
                            @if (isSystemAdmin)
                            {
                                <a class="app-nav__dropdown-item @usersActive" href="@usersUrl"><i class="bi bi-person-gear" aria-hidden="true"></i> Users</a>
                                <a class="app-nav__dropdown-item" href="#"><i class="bi bi-gear" aria-hidden="true"></i> Config</a>
                            }
                        </div>
                    </div>
                }
            }
        </nav>

        @if (isSignedIn)
        {
            <div class="app-user">
                <button type="button" class="app-user__button" id="user-toggle" aria-haspopup="true" aria-expanded="false" aria-controls="user-menu">
                    <span class="app-user__text">
                        <span class="app-user__name"><i class="bi bi-person-fill"></i> @userName</span>
                        <span class="app-user__role">@roleName</span>
                    </span>
                    <i class="bi bi-chevron-down app-user__chevron" aria-hidden="true"></i>
                </button>
                <div class="app-user__menu" id="user-menu">
                    @using (Html.BeginForm("Logout", "Account", FormMethod.Post, new { style = "margin:0;" }))
                    {
                        @Html.AntiForgeryToken()
                        <button type="submit" class="app-user__menu-item">
                            <i class="bi bi-box-arrow-right" aria-hidden="true"></i> Log out
                        </button>
                    }
                </div>
            </div>
        }
    </header>

    <main class="app-main">
        @RenderBody()
    </main>

    <script src="~/Scripts/lottie.min.js"></script>
    <script>
        window.CourierApp = window.CourierApp || {};
        window.CourierApp.loaderAnimationUrl = '@Url.Content("~/Content/animations/Loading.json")';
    </script>
    <script src="~/Scripts/app/courier-app.js"></script>
    @RenderSection("scripts", required: false)
    <script>
        (function () {
            "use strict";
            var navToggle = document.getElementById("nav-toggle");
            var nav = document.getElementById("main-nav");
            var userToggle = document.getElementById("user-toggle");
            var userMenu = document.getElementById("user-menu");

            function setNav(open) {
                if (!navToggle) return;
                nav.classList.toggle("is-open", open);
                navToggle.setAttribute("aria-expanded", open ? "true" : "false");
            }
            function setUser(open) {
                if (!userToggle) return;
                userMenu.classList.toggle("is-open", open);
                userToggle.setAttribute("aria-expanded", open ? "true" : "false");
            }

            if (navToggle) {
                navToggle.addEventListener("click", function () {
                    setNav(!nav.classList.contains("is-open"));
                });
            }
            if (userToggle) {
                userToggle.addEventListener("click", function () {
                    setUser(!userMenu.classList.contains("is-open"));
                });
            }
            document.addEventListener("click", function (e) {
                if (userToggle && !userToggle.contains(e.target) && !userMenu.contains(e.target)) {
                    setUser(false);
                }
            });
            document.addEventListener("keydown", function (e) {
                if (e.key === "Escape") { setUser(false); setNav(false); }
            });
        })();
    </script>

    <button id="jump-top" type="button" aria-label="Back to top" title="Back to top">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"
         stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 15l6-6 6 6"/></svg>
</button>

<script>
    (function () {
        var btn = document.getElementById('jump-top');
        var SHOW_AFTER_PX = 250;

        function update() { btn.classList.toggle('show', window.scrollY > SHOW_AFTER_PX); }
        window.addEventListener('scroll', update, { passive: true });
        update();

        btn.addEventListener('click', function () {
            window.scrollTo({ top: 0, behavior: 'smooth' });
        });
    })();
</script>

    @if (ViewBag.HideFooter != true)
{
  <footer id="siteFooter" class="site-footer">
    <div class="footer-doodles" aria-hidden="true">

      <!-- QR doodle -->
      <svg class="d d-qr" viewBox="0 0 56 56">
        <path d="M6 14 V6 H14 M42 6 H50 V14 M50 42 V50 H42 M14 50 H6 V42"/>
        <rect x="14" y="14" width="10" height="10" rx="2"/>
        <rect x="32" y="14" width="10" height="10" rx="2"/>
        <rect x="14" y="32" width="10" height="10" rx="2"/>
        <circle cx="35" cy="35" r="2" class="fill"/>
        <circle cx="42" cy="40" r="1.6" class="fill"/>
        <circle cx="30" cy="42" r="1.6" class="fill"/>
        <circle cx="40" cy="30" r="1.4" class="fill"/>
      </svg>

      <!-- little dash -->
      <svg class="d d-dash" viewBox="0 0 40 28"><path d="M3 20 Q16 26 34 6"/></svg>

      <span class="footer-text">F20 Courier Services</span>

      <!-- arc -->
      <svg class="d d-arc" viewBox="0 0 40 28"><path d="M3 20 Q18 2 36 18"/></svg>

      <!-- arrow swoosh -->
      <svg class="d d-arrow" viewBox="0 0 60 36">
        <path d="M4 26 C20 32 38 30 54 16"/>
        <path d="M45 13 L55 15 L50 24"/>
      </svg>

      <!-- parcel -->
      <svg class="d d-box" viewBox="0 0 56 50">
        <path d="M28 5 L51 14 L28 24 L5 14 Z"/>
        <path d="M5 14 V35 L28 45 V24"/>
        <path d="M51 14 V35 L28 45"/>
        <path d="M16.5 9.5 L39.5 19"/>
      </svg>
    </div>
  </footer>
}

</body>
</html>