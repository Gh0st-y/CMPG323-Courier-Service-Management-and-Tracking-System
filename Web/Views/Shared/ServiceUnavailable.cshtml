@{
    // Stand-alone on purpose: no layout, no partials, nothing that could need the database that is down (T52)
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Service unavailable - Courier Service</title>
    <style>
        body {
            font-family: "Segoe UI", Arial, sans-serif;
            margin: 0;
            padding: 48px 16px;
            background: #f5f6f8;
            color: #1f2933;
        }

        main {
            max-width: 520px;
            margin: 0 auto;
            background: #fff;
            border-radius: 8px;
            padding: 32px;
            box-shadow: 0 1px 3px rgba(0,0,0,.12);
        }

        h1 {
            font-size: 1.5rem;
            margin-top: 0;
        }

        a {
            color: #1d4ed8;
        }
    </style>
</head>
<body>
    <main role="alert">
        <h1>Service unavailable</h1>
        <p>The system can't reach its database right now, so nothing can be looked up or saved.</p>
        <p>Please wait a few minutes and <a href="">try again</a>. If it keeps happening, tell the system administrator.</p>
    </main>
</body>
</html>