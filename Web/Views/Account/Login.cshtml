@model CourierService.Web.Models.LoginViewModel

@{
    ViewBag.Title = "Log in";
    var message = ViewBag.Message as string;
}

<h1 class="app-page-title">Sign in</h1>

<div class="card">
    <p>Enter your username or email and password to continue.</p>

    @if (!string.IsNullOrWhiteSpace(message))
    {
    <div class="toast toast--info">@message</div>
    }

    @using (Html.BeginForm("Login", "Account", FormMethod.Post))
    {
    @Html.AntiForgeryToken()
    @Html.Hidden("returnUrl", ViewBag.ReturnUrl as string)

    @Html.ValidationSummary(true, "", new { @class = "field-error" })

    <fieldset class="form-section">
        <legend>Account details</legend>

        <div class="form-row">
            @Html.LabelFor(m => m.UsernameOrEmail)
            @Html.TextBoxFor(m => m.UsernameOrEmail, new { autocomplete = "username" })
            @Html.ValidationMessageFor(m => m.UsernameOrEmail, "", new { @class = "field-error" })
        </div>

        <div class="form-row">
            @Html.LabelFor(m => m.Password)
            <div style="display: flex; gap: 8px; align-items: center;">
                @Html.PasswordFor(m => m.Password, new { autocomplete = "current-password", id = "password-input", style = "flex: 1;" })
                <button type="button" class="btn btn-secondary" id="toggle-password">Show password</button>
            </div>
            @Html.ValidationMessageFor(m => m.Password, "", new { @class = "field-error" })
        </div>
    </fieldset>

    <div class="form-actions">
        <button type="submit" class="btn btn-primary">Sign in</button>
    </div>
    }

    @section scripts {
    <script>(function () {
                "use strict";

                var passwordInput = document.getElementById("password-input");
                var toggleButton = document.getElementById("toggle-password");

                if (!passwordInput || !toggleButton) {
                    return;
                }

                toggleButton.addEventListener("click", function () {
                    var isHidden = passwordInput.type === "password";
                    passwordInput.type = isHidden ? "text" : "password";
                    toggleButton.textContent = isHidden ? "Hide password" : "Show password";
                });
            }());</script>
    }
</div>