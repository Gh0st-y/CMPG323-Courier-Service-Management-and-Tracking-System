@{
    ViewBag.Title = "Scan";
}

<h1 class="app-page-title"><i class="bi bi-upc-scan"></i> Scan</h1>
<p>
    Scan a package with a USB scanner or a phone camera. Both look the package up the same way
    (<code>GET /api/packages/scan/{f20Identifier}</code>), then you can move it to its next status.
    You need to be logged in as storage staff, a supervisor or an admin to change a status.
    Notes on scanners and HTTPS: <code>docs/SCANNING_SPIKE.md</code>.
</p>

<div class="card" style="margin-bottom: 16px;">
    <h2 style="margin-top: 0;">(a) USB scanner (keyboard/HID mode)</h2>
    <p>
        Click into the box below and scan (or, without hardware, type an identifier like
        <code>F20-0001</code> and press Enter &#8208; that's exactly what a HID-mode scanner sends).
    </p>
    <input type="text" id="usb-scan-input" placeholder="Scan or type an F20 identifier, then Enter"
           style="width: 320px; padding: 8px; font-size: 14px; border: 1px solid var(--color-border); border-radius: var(--radius);" />
    <button type="button" class="btn btn-secondary" id="usb-refocus">Refocus input</button>
</div>

<div class="card" style="margin-bottom: 16px;">
    <h2 style="margin-top: 0;">(b) Phone camera (QR, via html5-qrcode)</h2>

    <div id="qr-secure-warning" style="display: none; background: var(--color-error-bg); border-left: 4px solid var(--color-error); padding: 12px; border-radius: var(--radius); margin-bottom: 12px;">
        <strong>Camera access needs a secure context.</strong> This page is being served over
        plain HTTP from a non-localhost origin, so the browser will refuse camera access —
        this is flagged instead of letting it fail silently. Use HTTPS (or open this from
        <code>localhost</code> on the same machine) to test the camera path.
    </div>

    <div id="qr-reader" style="width: 320px;"></div>
    <p>
        <button type="button" class="btn btn-primary" id="qr-start">Start camera scan</button>
        <button type="button" class="btn btn-primary" id="qr-start-mobile" style="margin-left: 8px;">Scan with Mobile Camera</button>
        <button type="button" class="btn btn-secondary" id="qr-stop" disabled>Stop</button>
    </p>
</div>

<div class="card">
    <h2 style="margin-top: 0;">Result</h2>
    <pre id="scan-result" style="background: var(--color-bg); padding: 12px; border-radius: var(--radius); min-height: 40px;">(nothing scanned yet)</pre>

    <!-- Status & Storage Location Update Section placed directly below result -->
    <div id="status-update-card" class="card" style="display: none; margin-top: 20px;">
        <h3 class="app-page-title" style="font-size: 18px; margin-bottom: 16px;">Update Package Status & Storage Location</h3>

        <div class="form-row">
            <label for="status-select">Next Status <span class="required">*</span></label>
            <select id="status-select">
                <!-- Dynamic options populated via JavaScript -->
            </select>
            <span class="field-error" id="status-select-error"></span>
        </div>

        <div class="form-row">
            <label for="location-select">Storage Location <span class="optional">(optional)</span></label>
            <select id="location-select">
                <option value="">(keep current location)</option>
            </select>
            <span class="field-error" id="location-select-error"></span>
        </div>

        <p id="status-update-note" style="color: var(--color-text-muted);"></p>

        <div class="form-actions">
            <button type="button" id="confirm-status-update" class="btn btn-primary">Confirm Update</button>
        </div>
    </div>
</div>

@section scripts {
    <script src="https://cdn.jsdelivr.net/npm/html5-qrcode@2.3.8/html5-qrcode.min.js"></script>
    <script src="~/Scripts/app/scan-demo.js"></script>
}
