@{
    ViewBag.Title = "Dashboard";
    var canRegister = (bool)ViewBag.CanRegister;
    var canSearch = (bool)ViewBag.CanSearch;
    var canCollect = (bool)ViewBag.CanCollect;
}

<h1 class="app-page-title">F20 Courier Service Dashboard</h1>

<div class="card dashboard-card">
<!-- TODO This is the Mock toggle remove later (dev tool)-->
<div class="dashboard-mock">
    <label class="mock-switch" for="toggle-mock-mode">
        <input type="checkbox" role="switch" id="toggle-mock-mode" class="mock-switch__input" />
        <span class="mock-switch__track" aria-hidden="true"></span>
        <span class="mock-switch__text">Mock mode: <strong id="mock-mode-label">OFF</strong></span>
    </label>
</div>

<section class="dashboard-alert" id="dashboard-error" role="alert" aria-live="assertive" hidden>
    <p class="dashboard-alert__title">Package counts could not be loaded.</p>
    <p class="dashboard-alert__text">
        Refresh the page, or contact the system administrator if this continues.
    </p>
    <div class="dashboard-alert__actions">
        <button type="button" class="btn btn-primary" id="dashboard-retry">Try again</button>
    </div>
</section>

<div class="dashboard-page">
    <section class="dashboard-section" aria-labelledby="dashboard-summary-title">
        <div class="dashboard-section__header">
            <div class="dashboard-section__heading">
                <div class="dashboard-section__title-row">
                    <h2 class="dashboard-section__title" id="dashboard-summary-title">Package summary</h2>
                    <p class="dashboard-section__meta" id="dashboard-updated-at" hidden></p>
                </div>
                <span class="dashboard-section__divider" aria-hidden="true"></span>
                <p class="dashboard-section__text">Counts are loaded from the backend API.</p>
            </div>

            <button type="button" class="btn btn-secondary" id="dashboard-refresh">
                <i class="bi bi-arrow-clockwise" id="refresh-icon"></i> Refresh summary
            </button>        </div>

        <div class="dashboard-stats" id="dashboard-stats" aria-live="polite" aria-busy="true">
            <article class="card dashboard-stat dashboard-stat--received">
                <span class="dashboard-stat__label">Received Today</span>
                <strong class="dashboard-stat__value" id="stat-received">—</strong>
                <span class="dashboard-stat__note">Packages received today</span>
            </article>

            <article class="card dashboard-stat dashboard-stat--ready">
                <span class="dashboard-stat__label">Ready for Collection</span>
                <strong class="dashboard-stat__value" id="stat-ready">—</strong>
                <span class="dashboard-stat__note">Current packages waiting for pickup</span>
            </article>

            <article class="card dashboard-stat dashboard-stat--collected">
                <span class="dashboard-stat__label">Collected Today</span>
                <strong class="dashboard-stat__value" id="stat-collected">—</strong>
                <span class="dashboard-stat__note">Packages collected today</span>
            </article>

            <article class="card dashboard-stat dashboard-stat--outstanding">
                <span class="dashboard-stat__label">Outstanding</span>
                <strong class="dashboard-stat__value" id="stat-outstanding">—</strong>
                <span class="dashboard-stat__note">Current packages not yet collected</span>
            </article>
        </div>
    </section>

    <section class="dashboard-section" aria-labelledby="dashboard-actions-title">
        <div class="dashboard-section__header">
            <div>
                <h2 class="dashboard-section__title" id="dashboard-actions-title">Quick actions</h2>
                <p class="dashboard-section__text">Only actions available to the current role are shown.</p>
            </div>
        </div>

        <div class="dashboard-actions">
            @if (canRegister)
            {
                <a class="dashboard-action dashboard-action--register" href="@Url.Action("Register", "Packages")">
                    <span class="dashboard-action__qr" aria-hidden="true"></span>
                    <span class="dashboard-action__body">
                        <span class="dashboard-action__title">Register package</span>
                        <span class="dashboard-action__description">Capture a new package record and generate the F20 identifier.</span>
                        <span class="dashboard-action__footnote">Intake and reception staff</span>
                    </span>
                    <svg class="dashboard-action__chevron" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true"><path fill-rule="evenodd" d="M4.646 1.646a.5.5 0 0 1 .708 0l6 6a.5.5 0 0 1 0 .708l-6 6a.5.5 0 0 1-.708-.708L10.293 8 4.646 2.354a.5.5 0 0 1 0-.708" /></svg>
                </a>
            }
            else
            {
                <div class="dashboard-action dashboard-action--locked" aria-hidden="true"><span class="dashboard-action__qr"></span></div>
            }

            @if (canSearch)
            {
                <a class="dashboard-action dashboard-action--search" href="@Url.Action("Search", "Packages")">
                    <span class="dashboard-action__qr" aria-hidden="true"></span>
                    <span class="dashboard-action__body">
                        <span class="dashboard-action__title">Search / Scan</span>
                        <span class="dashboard-action__description">Look up a package or jump into the scan workflow.</span>
                        <span class="dashboard-action__footnote">Search, tracking and QR scanning</span>
                    </span>
                    <svg class="dashboard-action__chevron" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true"><path fill-rule="evenodd" d="M4.646 1.646a.5.5 0 0 1 .708 0l6 6a.5.5 0 0 1 0 .708l-6 6a.5.5 0 0 1-.708-.708L10.293 8 4.646 2.354a.5.5 0 0 1 0-.708" /></svg>
                </a>
            }
            else
            {
                <div class="dashboard-action dashboard-action--locked" aria-hidden="true"><span class="dashboard-action__qr"></span></div>
            }

            @if (canCollect)
            {
                <a class="dashboard-action dashboard-action--collect" href="@Url.Action("Index", "Collection")">
                    <span class="dashboard-action__qr" aria-hidden="true"></span>
                    <span class="dashboard-action__body">
                        <span class="dashboard-action__title">Collect package</span>
                        <span class="dashboard-action__description">Verify a package and move it through the collection flow.</span>
                        <span class="dashboard-action__footnote">Collection verification staff</span>
                    </span>
                    <svg class="dashboard-action__chevron" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true"><path fill-rule="evenodd" d="M4.646 1.646a.5.5 0 0 1 .708 0l6 6a.5.5 0 0 1 0 .708l-6 6a.5.5 0 0 1-.708-.708L10.293 8 4.646 2.354a.5.5 0 0 1 0-.708" /></svg>
                </a>
            }
            else
            {
                <div class="dashboard-action dashboard-action--locked" aria-hidden="true"><span class="dashboard-action__qr"></span></div>
            }
        </div>
    </section>
</div>
</div>

@section scripts {
    <script>
        (function () {
            "use strict";

            var statReceivedEl = document.getElementById("stat-received");
            var statReadyEl = document.getElementById("stat-ready");
            var statCollectedEl = document.getElementById("stat-collected");
            var statOutstandingEl = document.getElementById("stat-outstanding");
            var dashboardStatsEl = document.getElementById("dashboard-stats");
            var updatedAtEl = document.getElementById("dashboard-updated-at");
            var dashboardErrorEl = document.getElementById("dashboard-error");
            var refreshButtonEl = document.getElementById("dashboard-refresh");
            var retryButtonEl = document.getElementById("dashboard-retry");
            var refreshIconEl = document.getElementById("refresh-icon");

            function formatCount(value) {
                if (value === null || value === undefined) {
                    return "—";
                }

                return Number(value).toLocaleString("en-ZA");
            }

            // Received and Collected are today only; Ready for Collection and Outstanding are current totals.
            function setStatValues(data) {
                statReceivedEl.textContent = formatCount(data.receivedToday);
                statReadyEl.textContent = formatCount(data.readyForCollection);
                statCollectedEl.textContent = formatCount(data.collectedToday);
                statOutstandingEl.textContent = formatCount(data.outstanding);
            }

            function setLoadingState(isLoading) {
                dashboardStatsEl.setAttribute("aria-busy", isLoading ? "true" : "false");
                updatedAtEl.hidden = !isLoading;
                refreshButtonEl.disabled = isLoading;
                retryButtonEl.disabled = isLoading;
                refreshIconEl.classList.toggle("spin", isLoading);
            }

            function showError() {
                dashboardErrorEl.hidden = false;
            }

            function hideError() {
                dashboardErrorEl.hidden = true;
            }

            var MIN_SPIN_MS = 700;

            function loadDashboardStats() {
                var started = Date.now();

                setLoadingState(true);
                hideError();

                return CourierApp.api.get("/dashboard/stats", { silent: true }).then(function (data) {
                    setStatValues(data || {});
                }).catch(function () {
                    setStatValues({});
                    showError();
                }).then(function () {
                    var wait = Math.max(0, MIN_SPIN_MS - (Date.now() - started));
                    return new Promise(function (resolve) { setTimeout(resolve, wait); });
                }).then(function () {
                    setLoadingState(false);
                });
            }

            refreshButtonEl.addEventListener("click", loadDashboardStats);
            retryButtonEl.addEventListener("click", loadDashboardStats);
            //TODO Remove the functioning of the mockmode
            var mockLabelEl = document.getElementById("mock-mode-label");
            var mockToggleEl = document.getElementById("toggle-mock-mode");

            function refreshMockLabel() {
                mockToggleEl.checked = !!CourierApp.config.mockMode;
                mockLabelEl.textContent = mockToggleEl.checked ? "ON" : "OFF";
            }

            mockToggleEl.addEventListener("change", function () {
                CourierApp.config.setMockMode(mockToggleEl.checked);
                refreshMockLabel();
                loadDashboardStats();
            });

            refreshMockLabel();//END of mockmode

            loadDashboardStats();
        })();
    </script>
}
