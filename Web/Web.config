<?xml version="1.0" encoding="utf-8"?>
<!--
  T02: connection string and appSettings wired from Web.config.sample.xml (T06).
  Do NOT put real SMTP credentials or secrets here — see Web.config.Local (gitignored)
  or an environment-specific transform for anything secret.
-->
<configuration>
  <connectionStrings>
    <add name="CourierServiceDb"
         connectionString="Server=(localdb)\MSSQLLocalDB;Database=CourierService;Trusted_Connection=True;"
         providerName="System.Data.SqlClient" />
  </connectionStrings>

  <appSettings>
    <!-- SMTP (T26). Point this at a local dev inbox (smtp4dev / Papercut) during development. -->
    <add key="Smtp.Host" value="localhost" />
    <add key="Smtp.Port" value="25" />
    <add key="Smtp.FromAddress" value="courier-noreply@f20.local" />
    <add key="Smtp.UseSsl" value="false" />

    <!-- SMS (T29). Leave disabled until a real gateway is confirmed (DECISIONS.md #6). -->
    <add key="Sms.Enabled" value="false" />
    <add key="Sms.Provider" value="Stub" />

    <!-- Session -->
    <add key="Session.InactivityTimeoutMinutes" value="30" />

    <add key="webpages:Version" value="3.0.0.0" />
    <add key="webpages:Enabled" value="false" />
    <add key="ClientValidationEnabled" value="true" />
    <add key="UnobtrusiveJavaScriptEnabled" value="true" />
  </appSettings>

  <system.web>
    <compilation debug="true" targetFramework="4.8" />
    <httpRuntime targetFramework="4.8" />
    <!-- Matches Session.InactivityTimeoutMinutes above; cookie is HttpOnly per DECISIONS.md auth choice. -->
    <sessionState mode="InProc" timeout="30" cookieless="false">
    </sessionState>
    <httpCookies httpOnlyCookies="true" requireSSL="false" />
    <customErrors mode="RemoteOnly" />
  </system.web>

  <system.webServer>
    <validation validateIntegratedModeConfiguration="false" />
    <modules runAllManagedModulesForAllRequests="true" />
  </system.webServer>

  <runtime>
    <assemblyBinding xmlns="urn:schemas-microsoft-com:asm.v1">
      <dependentAssembly>
        <assemblyIdentity name="System.Web.Mvc" publicKeyToken="31bf3856ad364e35" culture="neutral" />
        <bindingRedirect oldVersion="0.0.0.0-5.2.9.0" newVersion="5.2.9.0" />
      </dependentAssembly>
      <dependentAssembly>
        <assemblyIdentity name="System.Web.WebPages" publicKeyToken="31bf3856ad364e35" culture="neutral" />
        <bindingRedirect oldVersion="0.0.0.0-3.0.0.0" newVersion="3.0.0.0" />
      </dependentAssembly>
      <dependentAssembly>
        <assemblyIdentity name="System.Web.Helpers" publicKeyToken="31bf3856ad364e35" culture="neutral" />
        <bindingRedirect oldVersion="0.0.0.0-3.0.0.0" newVersion="3.0.0.0" />
      </dependentAssembly>
      <dependentAssembly>
        <assemblyIdentity name="System.Web.Razor" publicKeyToken="31bf3856ad364e35" culture="neutral" />
        <bindingRedirect oldVersion="0.0.0.0-3.0.0.0" newVersion="3.0.0.0" />
      </dependentAssembly>
      <dependentAssembly>
        <assemblyIdentity name="Microsoft.Web.Infrastructure" publicKeyToken="31bf3856ad364e35" culture="neutral" />
        <bindingRedirect oldVersion="0.0.0.0-2.0.1.0" newVersion="2.0.1.0" />
      </dependentAssembly>
    </assemblyBinding>
  </runtime>
</configuration>
